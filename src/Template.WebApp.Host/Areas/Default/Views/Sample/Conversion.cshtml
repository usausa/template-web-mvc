@model ConversionSampleForm
@{
    ViewData.SetTitle("入力変換");
}

<h4 class="mb-3">入力変換</h4>

<app-validation-summary></app-validation-summary>

<form method="post">
    <div class="row mb-3">
        <label asp-for="Name" class="col-form-label col-sm-2">氏名</label>
        <div class="col-sm-4">
            <input type="text" asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="Kana" class="col-form-label col-sm-2">フリガナ</label>
        <div class="col-sm-4">
            <input type="text" asp-for="Kana" class="form-control" />
            <span asp-validation-for="Kana" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="Code" class="col-form-label col-sm-2">コード</label>
        <div class="col-sm-4">
            <input type="text" asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">確認</button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/kana-convert.js" asp-append-version="true"></script>
}
