@model ConversionSampleForm
@{
    ViewData.SetTitle("入力変換");
}

<h4 class="mb-3">入力変換</h4>

<app-validation-summary></app-validation-summary>

<form method="post">
    <h5 class="mb-3">サーバーで変換</h5>
    <div class="row mb-3">
        <label asp-for="ServerName" class="col-form-label col-sm-2">氏名</label>
        <div class="col-sm-4">
            <input type="text" asp-for="ServerName" class="form-control" />
            <span asp-validation-for="ServerName" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="ServerKana" class="col-form-label col-sm-2">フリガナ</label>
        <div class="col-sm-4">
            <input type="text" asp-for="ServerKana" class="form-control" />
            <span asp-validation-for="ServerKana" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="ServerCode" class="col-form-label col-sm-2">コード</label>
        <div class="col-sm-4">
            <input type="text" asp-for="ServerCode" class="form-control" />
            <span asp-validation-for="ServerCode" class="text-danger"></span>
        </div>
    </div>
    <h5 class="mt-4 mb-3">画面でも変換</h5>
    <div class="row mb-3">
        <label asp-for="BrowserName" class="col-form-label col-sm-2">氏名</label>
        <div class="col-sm-4">
            <input type="text" asp-for="BrowserName" class="form-control" />
            <span asp-validation-for="BrowserName" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="BrowserKana" class="col-form-label col-sm-2">フリガナ</label>
        <div class="col-sm-4">
            <input type="text" asp-for="BrowserKana" class="form-control" />
            <span asp-validation-for="BrowserKana" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3">
        <label asp-for="BrowserCode" class="col-form-label col-sm-2">コード</label>
        <div class="col-sm-4">
            <input type="text" asp-for="BrowserCode" class="form-control" />
            <span asp-validation-for="BrowserCode" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">確認</button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/kana-convert.js" asp-append-version="true"></script>
}
