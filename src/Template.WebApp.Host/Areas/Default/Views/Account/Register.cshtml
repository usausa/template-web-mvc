@model AccountRegisterForm
@{
    Layout = "_LayoutSimple";
    ViewData.SetTitle("新規登録");
}

<div class="d-flex justify-content-center">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">新規登録</h4>
        </div>
        <div class="card-body">
            <form method="post" asp-antiforgery="true">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row mb-3">
                    <label asp-for="Name" class="col-form-label col-md-4">ID</label>
                    <div class="col-md-8">
                        <input type="text" asp-for="Name" class="form-control" maxlength="@Length.Name" autocomplete="username" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="Password" class="col-form-label col-md-4">パスワード</label>
                    <div class="col-md-8">
                        <input type="password" asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <label asp-for="ConfirmPassword" class="col-form-label col-md-4">確認</label>
                    <div class="col-md-8">
                        <input type="password" asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-12 text-center">
                        <button type="submit" class="btn btn-primary">登録</button>
                    </div>
                </div>
                <hr />
                <div class="row mb-0">
                    <div class="col-md-12 text-center">
                        <a asp-action="Login">ログインへ戻る</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
